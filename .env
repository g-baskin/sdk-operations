AI_PROVIDER_API_KEY=REDACTED_PASTE_REAL_KEY_IN_ENV_LOCAL

# Choose one OpenAI-compatible primary base URL:
# OpenAI
# AI_PROVIDER_BASE_URL=https://api.openai.com/v1
# OpenRouter
AI_PROVIDER_BASE_URL=https://openrouter.ai/api/v1
# Groq
# AI_PROVIDER_BASE_URL=https://api.groq.com/openai/v1
# Together AI
# AI_PROVIDER_BASE_URL=https://api.together.xyz/v1
# Fireworks AI
# AI_PROVIDER_BASE_URL=https://api.fireworks.ai/inference/v1
# Perplexity
# AI_PROVIDER_BASE_URL=https://api.perplexity.ai
# DeepSeek
# AI_PROVIDER_BASE_URL=https://api.deepseek.com
# xAI
# AI_PROVIDER_BASE_URL=https://api.x.ai/v1
# Mistral
# AI_PROVIDER_BASE_URL=https://api.mistral.ai/v1
# Cerebras
# AI_PROVIDER_BASE_URL=https://api.cerebras.ai/v1
# Local Ollama OpenAI-compatible server
# AI_PROVIDER_BASE_URL=http://localhost:11434/v1

# Primary routing models: fast for straightforward requests, flagship for complex requests.
AI_PROVIDER_FAST_MODEL=openai/gpt-4o-mini
AI_PROVIDER_FLAGSHIP_MODEL=openai/gpt-4o

# Optional backup provider used when the primary provider fails or is rate-limited.
AI_BACKUP_PROVIDER_API_KEY=
AI_BACKUP_PROVIDER_BASE_URL=https://api.openai.com/v1
AI_BACKUP_PROVIDER_FAST_MODEL=gpt-4o-mini
AI_BACKUP_PROVIDER_FLAGSHIP_MODEL=gpt-4o
